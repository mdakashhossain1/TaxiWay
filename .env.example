APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tailadmin_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase project ID backing the taxiway/taxiwaydriver Google Sign-In flow —
# only the project ID is needed since ID tokens are verified locally against
# Google's public JWKS, not the Firebase Admin SDK.
FIREBASE_PROJECT_ID=

# Public browser key — Firebase Console > Project Settings > General >
# "Web API Key" (project-wide; no need to register a separate Web app to get
# it). Used by the admin panel's Support Chat page for client-side Firestore
# access. Not a secret; safe to expose in browser JS.
FIREBASE_WEB_API_KEY=

# Absolute path to the service-account JSON file (Firebase console > Project
# Settings > Service Accounts > Generate new private key) — used both by
# FirestoreService (server-side Firestore reads/writes, bypassing Security
# Rules) and by kreait/laravel-firebase for FCM push notifications.
#
# This is a FILE PATH, not the JSON content itself — the multi-line
# private_key field doesn't belong inline in a .env value. Easiest way to
# set this correctly: use the admin panel's Settings > Firebase Credentials
# page, which uploads the file to storage/app/private/firebase-credentials.json
# and writes this value for you automatically.
FIREBASE_CREDENTIALS=

# SMS OTP gateway — all editable from Settings > SMS Gateway in the admin
# panel, kept here only as the fallback/default. When SMS_GATEWAY_ENABLED is
# false, OtpService never calls out and instead returns the code directly in
# the API response (debug mode) so the app can display it without real SMS.
#
# Two gateway profiles are kept configured side by side; SMS_GATEWAY_MODE
# picks which one OtpService actually sends through.
SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_MODE=otp
SMS_GATEWAY_API_KEY=

# Non-DLT route — Fast2SMS's dedicated Smart OTP API (JSON POST). `otp` is
# passed explicitly so the texted code matches the one OtpService cached —
# without it Fast2SMS generates its own, unverifiable, code.
SMS_GATEWAY_OTP_METHOD=post
SMS_GATEWAY_OTP_PAYLOAD_URL=https://www.fast2sms.com/dev/otp/send
SMS_GATEWAY_OTP_TEMPLATE_ID=
SMS_GATEWAY_OTP_PAYLOAD_TEMPLATE={"otp_id":"{template_id}","mobile":"{phone}","otp":"{otp}"}

# TRAI DLT-registered template route — Fast2SMS documents this one as GET
# with query-string params (POSTing JSON to it 404s); requires your
# DLT-approved Template ID and registered Sender ID, and some providers
# besides Fast2SMS also require the DLT Entity/PE ID.
# "Customer|{otp}" below matches a template registered with two variables
# (name, code) — change to just "{otp}" if your template only has one.
SMS_GATEWAY_DLT_METHOD=get
SMS_GATEWAY_DLT_PAYLOAD_URL=https://www.fast2sms.com/dev/bulkV2
SMS_GATEWAY_DLT_TEMPLATE_ID=
SMS_GATEWAY_DLT_SENDER_ID=
SMS_GATEWAY_DLT_ENTITY_ID=
SMS_GATEWAY_DLT_PAYLOAD_TEMPLATE={"route":"dlt","sender_id":"{sender_id}","message":"{template_id}","variables_values":"Customer|{otp}","numbers":"{phone}"}

# Support phone number shown in taxiway/taxiwaydriver for "Contact Support" /
# "Call Office" actions — editable from Settings > Contact Number.
SUPPORT_CONTACT_NUMBER=

# Shared secret for GET /cron/run?token=... — an HTTP-triggerable equivalent
# of crontab's `php artisan schedule:run`, for an external server hitting
# this over HTTP instead of a local cron. Generate your own random value
# (e.g. `php -r "echo bin2hex(random_bytes(32));"`) — never reuse the
# example below.
CRON_SECRET=
