rules_version = '2';

// Deploy: Firebase Console > Firestore Database > Rules, or `firebase deploy
// --only firestore:rules` if you use the Firebase CLI. Not deployed
// automatically by this repo — Firestore rules live in the Firebase project,
// not in application code.
//
// Trust model: conversation documents (`conversations/{id}`) are written
// ONLY by the Laravel backend, using a service-account OAuth2 token
// (App\Services\FirestoreService) that bypasses these rules entirely — the
// same way the Firebase Admin SDK would. Clients (the mobile apps and the
// admin Support Chat page) can never create or modify a conversation
// document, only read one they're a participant of and append messages to
// it. This is what stops a signed-in customer from fabricating a
// `participants` array to snoop on someone else's ride or support thread.
service cloud.firestore {
  match /databases/{database}/documents {
    // Live trip tracking: the driver app publishes its position and status to
    // `live_trips/{bookingId}`; the rider app subscribes. Access is gated on
    // the SAME participants list the Laravel backend already writes onto the
    // ride's conversation (`conversations/ride_{bookingId}`), so no extra
    // backend seeding is needed — both rider and driver are participants of a
    // ride the moment it exists. Writes are restricted to the known telemetry
    // fields. (To lock writes to the driver alone, add a `driverUid` to the
    // conversation doc and require request.auth.uid == that here.)
    match /live_trips/{bookingId} {
      function rideParticipants() {
        return get(/databases/$(database)/documents/conversations/ride_$(bookingId)).data.participants;
      }

      allow read: if request.auth != null && request.auth.uid in rideParticipants();

      allow write: if request.auth != null
        && request.auth.uid in rideParticipants()
        && request.resource.data.keys().hasOnly(
             ['status', 'driverLat', 'driverLng', 'driverHeading', 'routeProgress', 'updatedAt']);
    }

    // Driver live positions for the rider app's nearby-driver search (indexed
    // by H3 cell in `h3r8`). A driver writes only their own document, keyed by
    // their Firebase uid; any signed-in user may read (riders need to see the
    // cars around them, the same approximate visibility Uber shows pre-booking).
    match /driver_locations/{driverUid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == driverUid
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'h3r8', 'available', 'updatedAt']);
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 4000;

        allow update, delete: if false;
      }
    }
  }
}
