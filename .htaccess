<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files that live under /public (css, js, images, etc.) directly.
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Everything else goes through the front controller in this folder,
    # which forwards to Laravel's real front controller in /public.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
